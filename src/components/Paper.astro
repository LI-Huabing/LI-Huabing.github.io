---
import { render, type CollectionEntry } from "astro:content";
import { figureOf, pageOf } from "../lib/papers";
import Byline from "./Byline.astro";
import Honours from "./Honours.astro";
import PaperFigure from "./PaperFigure.astro";
import PaperLinks from "./PaperLinks.astro";

interface Props {
  paper: CollectionEntry<"papers">;
}
const { paper } = Astro.props;
const { Content } = await render(paper);
const figure = figureOf(paper);
---

<li class="paper">
  <div class="text">
    <p class:list={["title", { working: paper.data.workingTitle }]}><a href={pageOf(paper)}>{paper.data.title}</a></p>
    <Honours paper={paper} />
    {
      paper.body?.trim() && (
        <div class="finding">
          <Content />
        </div>
      )
    }
    <Byline paper={paper} />
    <PaperLinks paper={paper} />
  </div>
  {
    figure && (
      <div class="fig">
        <PaperFigure svg={figure} />
      </div>
    )
  }
</li>

<style>
  .paper {
    display: grid;
    grid-template-columns: minmax(0, calc(28.5 * var(--row))) minmax(calc(25 * var(--u)), 1fr);
    column-gap: calc(4 * var(--u));
    align-items: start;
  }
  .paper + .paper { margin-top: calc(6 * var(--u)); }

  .title { font-size: var(--row); font-style: italic; line-height: 1.35; }
  .title.working { color: var(--pencil); }

  .finding { margin-top: 0.5em; font-size: var(--row); line-height: 1.5; color: var(--pencil); text-wrap: pretty; }
  .finding :global(p + p) { margin-top: 0.5em; }

  .fig { padding-top: calc(0.3 * var(--row)); }

  @media (max-aspect-ratio: 5/4), (max-width: 760px) {
    .paper { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: 32px; }
    .paper + .paper { margin-top: 48px; }
  }
  @media (max-width: 600px) {
    .paper { grid-template-columns: minmax(0, 1fr); }
    .fig { order: -1; padding-top: 0; margin-bottom: 18px; }
  }
</style>
