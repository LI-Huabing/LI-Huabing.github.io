---
import { bachelor, degrees, minors, years } from "../lib/cv";
import { leafSize, leafSrc } from "../lib/leaves";
---

<ol class="education">
  {
    degrees.toReversed().map((d) => (
      <li>
        <p class="degree">{d.degree}</p>
        <p class="detail meta">{d.detail}, {years(d)}</p>
        <ol class="stays">
          {d.stops.toReversed().map((s) => (
            <li>
              <img class="key" src={leafSrc(s.leaf)} {...leafSize(s.leaf)} alt="" />
              <span class="city">{s.city}</span>
              <span class="where meta">{s.school}, {s.from.slice(0, 4)}</span>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
  <li>
    <p class="degree">{bachelor.degree}</p>
    <p class="detail meta">{minors}</p>
    <p class="detail meta">{bachelor.school}, {bachelor.city}, {years(bachelor)}</p>
  </li>
</ol>

<style>
  .education { list-style: none; padding: 0; }
  .education > li + li { margin-top: calc(3 * var(--u)); }

  .degree { font-size: var(--row); line-height: 1.3; }
  .detail { margin-top: 0.15em; color: var(--pencil); }

  .stays { list-style: none; padding: 0; margin-top: 0.6em; }
  .stays li {
    display: grid;
    grid-template-columns: 1.4em auto minmax(0, 1fr);
    column-gap: 0.55em;
    align-items: baseline;
    font-size: var(--row);
    line-height: 1.45;
  }
  .key { width: auto; height: 1.15em; align-self: center; rotate: 38deg; justify-self: center; }
  .city { font-style: italic; }
  .where { color: var(--pencil); }
</style>
